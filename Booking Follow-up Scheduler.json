{
  "name": "Booking Follow-up Scheduler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "booking-followup",
        "options": {
          "responseData": "{\"ok\":true,\"message\":\"Follow-up scheduled. A reminder will be sent in about 2 hours if the customer has not booked.\"}"
        }
      },
      "id": "1cb94779-b245-432f-9a06-37b8e3e1ab77",
      "name": "Schedule Follow-up",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "webhookId": "251eff8a-3528-43c7-813c-155c19568ac4"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f-1",
              "name": "chat_id",
              "type": "string",
              "value": "={{ String($json.body?.chat_id ?? \"\").replace(/[^0-9-]/g, \"\") }}"
            },
            {
              "id": "f-2",
              "name": "customer_name",
              "type": "string",
              "value": "={{ String($json.body?.customer_name ?? \"\").replace(/[<>&\"]/g, \"\").slice(0, 40) }}"
            },
            {
              "id": "f-3",
              "name": "language",
              "type": "string",
              "value": "={{ $json.body?.language === \"en\" ? \"en\" : \"ar\" }}"
            },
            {
              "id": "f-4",
              "name": "context",
              "type": "string",
              "value": "={{ String($json.body?.context ?? \"\").replace(/[<>&\"]/g, \"\").slice(0, 80) }}"
            },
            {
              "id": "f-5",
              "name": "delay_minutes",
              "type": "number",
              "value": "={{ Math.min(1440, Math.max(30, Number($json.body?.delay_minutes ?? 120) || 120)) }}"
            },
            {
              "id": "f-6",
              "name": "started_at",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            },
            {
              "id": "f-7",
              "name": "clinic_name",
              "type": "string",
              "value": "={{ (() => { let e; let v; try { e = $env.CLINIC_NAME; } catch (x) { e = undefined; } try { v = $vars.CLINIC_NAME; } catch (x) { v = undefined; } return e || v || \"عيادة نور دنتيست\"; })() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "ccc89cb1-fd76-4863-8ada-78a969a35952",
      "name": "Normalize Request",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "notes": "Sanitizes everything the AI sends. The reminder text is built from fixed templates, never from free text."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.chat_id }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2a3ccda7-57f9-492e-ae49-b1579f3b2b11",
      "name": "Valid Chat?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "amount": "={{ $(\"Normalize Request\").first().json.delay_minutes }}",
        "unit": "minutes"
      },
      "id": "eb0a83a6-cd62-482b-84c3-7ce8e448cccf",
      "name": "Wait Before Reminder",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        720,
        -96
      ],
      "webhookId": "c21febeb-d71e-4e9a-ab31-c1d2c64438b3"
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "getAll",
        "projectRef": "cykcsuebotiegggnylua",
        "tableId": "bot_bookings",
        "returnAll": true,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "customer_chat_id",
              "condition": "eq",
              "keyValue": "={{ $(\"Normalize Request\").first().json.chat_id }}"
            },
            {
              "keyName": "created_at",
              "condition": "gte",
              "keyValue": "={{ $(\"Normalize Request\").first().json.started_at }}"
            }
          ]
        }
      },
      "id": "ecb61292-9ea2-4a9d-8e08-acb21e9ff795",
      "name": "Check Bookings Since",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        960,
        -96
      ],
      "alwaysOutputData": true,
      "executeOnce": true,
      "credentials": {
        "supabaseOAuth2Ap": {
          "id": "",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $('Normalize Request').first().json;\nconst booked = $('Check Bookings Since').all().some(i => i.json && i.json.id !== undefined && i.json.id !== null);\nconst ev = $('Get Events').all().map(i => i.json).filter(e => e && e.event && e.at);\nconst startedMs = Date.parse(r.started_at);\nconst after = e => Date.parse(e.at) > startedMs;\nconst cancelled = ev.some(e => e.event === 'cancel' && after(e));\nconst superseded = ev.some(e => e.event === 'scheduled' && after(e));\nconst dayAgo = Date.now() - 24 * 3600 * 1000;\nconst recentlyReminded = ev.some(e => e.event === 'reminded' && Date.parse(e.at) > dayAgo);\nconst send = !booked && !cancelled && !superseded && !recentlyReminded;\nconst ctx = r.context ? ' (' + r.context + ')' : '';\nconst first = String(r.customer_name || '').split(' ')[0];\nconst text = r.language === 'en'\n  ? 'Hi ' + (first || 'there') + ' 👋 Just checking in from ' + r.clinic_name + '. Your appointment request' + ctx + ' is still open. Reply here and I will send a fresh payment link or move it to a time that suits you 🦷'\n  : 'أهلاً ' + (first || 'بحضرتك') + ' 👋 معاك ' + r.clinic_name + '. لسه فاكرين طلب حجزك' + ctx + '. لو لسه حابب تكمل اكتبلي هنا وأنا أجهزلك رابط دفع جديد أو نغيّر الميعاد لأي وقت يناسبك 🦷';\nreturn [{ json: { send: send, chat_id: r.chat_id, text: text, booked: booked, cancelled: cancelled, superseded: superseded, recently_reminded: recentlyReminded } }];"
      },
      "id": "fe077c5a-3685-4837-93a4-9bb2fe1c57f3",
      "name": "Decide Reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        -96
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.send ? \"yes\" : \"no\" }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "yes"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7b3db023-ed78-42a3-aefc-578a4fa893b3",
