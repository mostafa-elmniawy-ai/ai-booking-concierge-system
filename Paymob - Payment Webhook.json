    {
      "parameters": {
        "jsCode": "const bookings = $('Expand Bookings').all().map(i => i.json);\nconst rows = $input.all().map(i => i.json).filter(r => r && r.id !== undefined && r.id !== null && String(r.status || '').toLowerCase() !== 'cancelled');\nreturn bookings.map(b => {\n  const hit = rows.find(r => String(r.booking_date).slice(0, 10) === b.booking_date && String(r.booking_time).slice(0, 5) === b.booking_time);\n  const state = !hit ? 'free' : (String(hit.customer_chat_id || '') === String(b.chat_id) ? 'duplicate' : 'conflict');\n  return { json: Object.assign({}, b, { slot_state: state }) };\n});"
      },
