      "id": "f20862f0-620a-4c5d-9b3b-fb90fbe286ed",
      "name": "Client Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "notes": "WHITE-LABEL SWITCH for this workflow. Reads $env, then $vars, then falls back to the placeholder. On n8n Cloud paste the real values here or create Variables (Pro)."
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst req = $('Paymob Callback').first().json;\nconst body = req.body || {};\nconst obj = body.obj || {};\nconst received = String((req.query && req.query.hmac) || body.hmac || '').toLowerCase();\nconst secret = String($('Client Config').first().json.hmac_secret || '');\nconst get = (o, p) => p.split('.').reduce((a, k) => (a === undefined || a === null) ? undefined : a[k], o);\nconst fields = ['amount_cents', 'created_at', 'currency', 'error_occured', 'has_parent_transaction', 'id', 'integration_id', 'is_3d_secure', 'is_auth', 'is_capture', 'is_refunded', 'is_standalone_payment', 'is_voided', 'order.id', 'owner', 'pending', 'source_data.pan', 'source_data.sub_type', 'source_data.type', 'success'];\nconst joined = fields.map(f => { const v = get(obj, f); return (v === undefined || v === null) ? '' : String(v); }).join('');\nlet valid = false;\nif (secret && secret.indexOf('PASTE_') !== 0 && received) {\n  try {\n    const calc = crypto.createHmac('sha512', secret).update(joined).digest('hex');\n    const a = Buffer.from(calc, 'hex');\n    const b = Buffer.from(received, 'hex');\n    valid = a.length === b.length && b.length > 0 && crypto.timingSafeEqual(a, b);\n  } catch (e) {\n    valid = false;\n  }\n}\nconst extras = (obj.payment_key_claims && obj.payment_key_claims.extra) || {};\nconst items = Array.isArray(extras.items) ? extras.items : [];\nconst amountOk = Math.round(Number(obj.amount_cents)) === Math.round(Number(extras.amount_egp) * 100);\nconst success = obj.success === true;\nconst pending = obj.pending === true;\nconst voided = obj.is_voided === true;\nconst refunded = obj.is_refunded === true;\nconst chatId = String(extras.chat_id || '');\nlet outcome = 'ignore';\nif (valid && chatId) {\n  if (success && !pending && !voided && !refunded) {\n    outcome = (amountOk && items.length > 0) ? 'paid' : 'mismatch';\n  } else if (!success && !pending) {\n    outcome = 'failed';\n  }\n}\nreturn [{ json: {\n  outcome: outcome,\n  hmac_valid: valid,\n  txn_id: obj.id,\n  amount_cents: obj.amount_cents,\n  reference: (obj.order && obj.order.merchant_order_id) || null,\n  chat_id: chatId,\n  extras: extras\n} }];"
      },
