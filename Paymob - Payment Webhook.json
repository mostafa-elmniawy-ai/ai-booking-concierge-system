      "parameters": {
        "jsCode": "const v = $('Verify HMAC & Parse').first().json;\nconst x = v.extras || {};\nconst items = Array.isArray(x.items) ? x.items : [];\nreturn items.map(i => ({ json: {\n  kind: x.kind || 'new',\n  chat_id: v.chat_id,\n  customer_name: x.customer_name,\n  customer_phone: x.customer_phone,\n  txn_id: v.txn_id,\n  reference: v.reference,\n  amount_egp: x.amount_egp,\n  service_id: i.service_id,\n  service_name: i.service_name,\n  booking_id: i.booking_id || null,\n  booking_date: i.booking_date,\n  booking_time: i.booking_time,\n  deposit_amount: i.deposit_amount,\n  deposit_total: i.deposit_total || null\n} }));"
