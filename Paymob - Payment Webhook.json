    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.id !== undefined && r.id !== null);\nif (!rows.length) return [];\nconst dec = $('Decide Slot State').all().map(i => i.json);\nconst cfg = $('Client Config').first().json;\nconst v = $('Verify HMAC & Parse').first().json;\nconst x = v.extras || {};\nconst esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst days = ['الأحد', 'الاثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];\nconst months = ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'];\nconst fmtDate = d => { const p = String(d).slice(0, 10).split('-').map(Number); const wd = new Date(Date.UTC(p[0], p[1] - 1, p[2])).getUTCDay(); return days[wd] + ' ' + p[2] + ' ' + months[p[1] - 1]; };\nconst fmtTime = t => { const h = parseInt(String(t).slice(0, 2), 10); const m = String(t).slice(3, 5); const suf = h === 12 ? 'ظهرًا' : (h > 12 ? 'م' : 'ص'); return ((h % 12) || 12) + ':' + m + ' ' + suf; };\nconst nameOf = r => { const d = dec.find(z => z.booking_time === String(r.booking_time).slice(0, 5) && z.booking_date === String(r.booking_date).slice(0, 10)) || {}; return d.service_name || 'الخدمة'; };\nconst lines = rows.map(r => '• ' + esc(nameOf(r)) + ' — ' + fmtDate(r.booking_date) + ' الساعة ' + fmtTime(r.booking_time) + ' (رقم الحجز ' + r.id + ')');\nconst text = '✅ <b>تم استلام العربون وتأكيد حجزك</b>\\n\\n' + lines.join('\\n') + '\\n\\nالاسم: ' + esc(x.customer_name) + '\\nالعربون المدفوع: ' + esc(x.amount_egp) + ' جنيه\\n\\nفي انتظارك في ' + esc(cfg.clinic_name) + ' 🦷\\nلو احتجت تغيير أو إلغاء استخدم الأزرار تحت.';\nconst ownerText = '✅ دفع عربون مؤكد (Paymob)\\nالاسم: ' + esc(x.customer_name) + '\\nالموبايل: ' + esc(x.customer_phone) + '\\n' + lines.join('\\n') + '\\nالمبلغ: ' + esc(x.amount_egp) + ' جنيه\\nPaymob txn: ' + esc(v.txn_id) + '\\nReference: ' + esc(v.reference);\nreturn [{ json: { chat_id: v.chat_id, text: text, owner_text: ownerText, first_id: rows[0].id } }];"
      },
