        "assignments": {
          "assignments": [
            {
              "id": "w-1",
              "name": "hmac_secret",
              "type": "string",
              "value": "={{ (() => { let e; let v; try { e = $env.PAYMOB_HMAC_SECRET; } catch (x) { e = undefined; } try { v = $vars.PAYMOB_HMAC_SECRET; } catch (x) { v = undefined; } return e || v || \"PASTE_PAYMOB_HMAC_SECRET\"; })() }}"
            },
            {
