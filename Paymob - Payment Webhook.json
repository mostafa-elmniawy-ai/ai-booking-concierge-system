            },
            {
              "id": "w-4",
              "name": "clinic_phone",
              "type": "string",
              "value": "={{ (() => { let e; let v; try { e = $env.CLINIC_PHONE; } catch (x) { e = undefined; } try { v = $vars.CLINIC_PHONE; } catch (x) { v = undefined; } return e || v || \"01092837405\"; })() }}"
